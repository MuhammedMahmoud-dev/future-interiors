# The TEST Supabase project — never production.
#
# Copy to .env.test and fill in from the test project's dashboard.
# .env.test is gitignored (.env* covers it); this example file is committed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_TEST_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Declares this environment a test target. scripts/lib/test-db.mjs refuses to
# run without it, so a stray .env pointed at some other project cannot be
# written to by accident.
FI_TEST_DB=1

# Any value — the verify scripts forge admin cookies with it. It does NOT need
# to match production, and should not.
# Must be at least 32 characters — src/lib/session.ts refuses anything shorter,
# and the failure surfaces as a 500 from every admin page rather than as a
# config error. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ADMIN_EMAIL=eng@futureinteriors.test

# Optional. A personal access token lets scripts/migrate-test-db.mjs run the
# migrations directly instead of writing a file for you to paste.
# Supabase dashboard -> account -> Access Tokens.
SUPABASE_ACCESS_TOKEN=
