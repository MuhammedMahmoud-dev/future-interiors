# Copy to .env.local and fill in from Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Server-side only. Bypasses RLS, so it must NEVER be prefixed with NEXT_PUBLIC_
# and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Not used in phase 1. Needed in phase 3 for admin auth.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Falls back to engineer_profile.whatsapp from the database.
# International format, digits only, no + and no spaces: 201234567890
NEXT_PUBLIC_WHATSAPP=

# Signs the client portal and admin session cookies. Required for /track and /admin.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every client and the admin out.
SESSION_SECRET=

# Admin login (/admin). Single user, no 2FA.
# Generate the hash with:
#   node scripts/admin-password.mjs "your password"
# The plaintext password is never stored. Rotating it means changing this value
# and redeploying.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
