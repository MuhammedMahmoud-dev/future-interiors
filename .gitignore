# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the TEST template carries no secrets and documents the setup.
!.env.test.example
# ...except the placeholder template, which the README tells you to copy.
!.env.example

# vercel
.vercel

# local dev preview data — a development tool, never a migration (spec §14)
/scripts/seed-dev-preview.mjs
/scripts/.seed-dev-preview.json
# Only the generated placeholder, which the dev seed writes to this exact name
# when photos-source/ is empty. The REAL hero photographs are committed: they are
# brand furniture and the largest contentful paint on the homepage, so they ship
# with the code and get a stable, edge-cached URL rather than an expiring signed
# one that would re-encode on every revalidate.
/public/hero.png

# source photography handed over for the preview seed — working files, not content
/photos-source/

# database exports — client names, phone numbers and every figure
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts
